# Copia este archivo a .env y ajusta lo que necesites. Ninguna llave real va en el repo.
PUERTO=3000
# Cada cuántos segundos la conciliación le pregunta a la pasarela por cobros sin aviso (ADR-004)
CONCILIAR_CADA_SEG=30

# Base de datos. Sin DATABASE_URL se usa SQLite en este archivo local:
RUTA_BD=data/barberos.db
# Con DATABASE_URL se usa PostgreSQL de Supabase (Connect → Transaction pooler, puerto 6543):
# DATABASE_URL=postgresql://postgres.<proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Pagos. Sin MP_ACCESS_TOKEN se usa la pasarela simulada (no se cobra nada).
# Con el Access Token de Mercado Pago se cobra de verdad (ADR-010). NUNCA va en el código ni en el repo.
# MP_ACCESS_TOKEN=APP_USR-...
# Acceder con Google (ADR-011): el "ID de cliente" OAuth de Google Cloud. No es secreto.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Dirección pública de la app: Mercado Pago regresa ahí al cliente y manda ahí su webhook (solo https).
# URL_BASE=https://barberos.<tu-subdominio>.workers.dev
